#!/bin/bash
set -euo pipefail

# Define a function for the dotfiles command. This is more robust than an alias for scripts.
dotfiles() {
    /usr/bin/git --git-dir="$HOME/.dotfiles/" --work-tree="$HOME" "$@"
}

# --- Hosts file ------------------------------------------------------------
# Single canonical location. Intentionally NOT tracked in git (we do not
# publish the list of machines) and kept outside the work-tree.
HOSTS_FILE="$HOME/.config/dotfiles/hosts"

ensure_hosts_file() {
    mkdir -p "$(dirname "$HOSTS_FILE")"
    if [ ! -f "$HOSTS_FILE" ]; then
        cat > "$HOSTS_FILE" <<'HDR'
# dotfiles-sync host list -- NOT tracked in git, not published to GitHub.
# One host (ssh alias) per line. Prefix a line with '#' to disable it.
HDR
    fi
}

# Enabled hosts: skip blanks, comments, and disabled '#host' lines.
enabled_hosts() {
    [ -f "$HOSTS_FILE" ] || return 0
    grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$HOSTS_FILE" | awk '{print $1}'
}

# Quick, non-interactive reachability check (never blocks on a password/prompt).
host_reachable() {
    ssh -o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=accept-new \
        -T "$1" true 2>/dev/null
}

# Regex-escape a hostname for use in sed/grep.
esc_re() { printf '%s' "$1" | sed 's/[.[\*^$/]/\\&/g'; }

usage() {
    cat >&2 <<USAGE
Usage: dotfiles-sync <command> [args]   (aliasable as 'dfs-sync')

  push [target...]   Push updates from the canonical repo.
                     Targets: specific hosts, 'all', or 'github'.
                       --force  overwrite local changes on remote hosts.
                     With no target: push to all ENABLED hosts + github.
                     Offline/unreachable hosts are skipped, not fatal.
  fetch <host>       Fetch changes from a non-canonical machine for review.
  diff <host>        Diff local 'main' vs a fetched host.
  list               Show hosts and whether each is enabled or disabled.
  on <host>          Enable a host (add it, or uncomment it).
  off <host>         Disable a host (comment it out; keeps it in the file).

  Hosts file: $HOSTS_FILE
              (untracked; not published to GitHub)
USAGE
    exit 1
}

# --- push ------------------------------------------------------------------
cmd_push() {
    local TARGET_HOSTS=()
    local PUSH_TO_GITHUB=false
    local FORCE_PUSH=false

    if [ "$#" -eq 0 ]; then
        echo "--- Pushing updates to all enabled hosts and GitHub ---"
        mapfile -t TARGET_HOSTS < <(enabled_hosts)
        PUSH_TO_GITHUB=true
    else
        echo "--- Pushing updates to specified targets ---"
        for arg in "$@"; do
            case "$arg" in
                --force) FORCE_PUSH=true ;;
                github)  PUSH_TO_GITHUB=true ;;
                all)     mapfile -t -O "${#TARGET_HOSTS[@]}" TARGET_HOSTS < <(enabled_hosts) ;;
                *)       TARGET_HOSTS+=("$arg") ;;
            esac
        done
        if [ ${#TARGET_HOSTS[@]} -gt 0 ]; then
            mapfile -t TARGET_HOSTS < <(printf '%s\n' "${TARGET_HOSTS[@]}" | awk 'NF' | sort -u)
        fi
    fi

    if [ ${#TARGET_HOSTS[@]} -eq 0 ] && [ "$PUSH_TO_GITHUB" = false ]; then
        echo "No hosts to sync. Enabled hosts come from: $HOSTS_FILE"
        echo "Use 'dotfiles-sync list' to review, or name a target (host, 'all', 'github')."
        exit 0
    fi

    local ok=() skipped=() failed=()

    for host in ${TARGET_HOSTS[@]+"${TARGET_HOSTS[@]}"}; do
        echo "--> Syncing to host: $host"

        if ! host_reachable "$host"; then
            echo "    OFFLINE/unreachable -- skipping (it will catch up on a later sync)." >&2
            skipped+=("$host")
            continue
        fi

        # Capture the remote's state BEFORE the push. Pushing to a bare repo's
        # checked-out branch moves its HEAD under the work-tree, which would
        # otherwise make every behind file look "locally modified". Recording
        # the old HEAD and the genuinely-dirty files first lets us update the
        # real incoming delta while preserving actual local edits.
        local pre old dirty
        if ! pre=$(ssh -o BatchMode=yes -T "$host" 'bash -s' <<'EOF' 2>/dev/null
dotfiles(){ /usr/bin/git --git-dir="$HOME/.dotfiles/" --work-tree="$HOME" "$@"; }
printf 'OLD %s\n' "$(dotfiles rev-parse HEAD 2>/dev/null || echo none)"
dotfiles -c status.showUntrackedFiles=no diff --name-only 2>/dev/null | sed 's/^/DIRTY /'
EOF
        ); then
            echo "    Could not read remote state -- skipping." >&2
            failed+=("$host")
            continue
        fi
        old=$(awk '/^OLD /{print $2}' <<<"$pre")
        dirty=$(awk '/^DIRTY /{print $2}' <<<"$pre")

        # 1. Push objects (guarded so one host cannot abort the whole run).
        if ! dotfiles push "$host" main; then
            echo "    Failed to push git objects." >&2
            failed+=("$host")
            continue
        fi

        # 2. Apply on the remote: update the incoming delta + restore missing
        #    files, but preserve genuinely-modified files unless --force.
        if ssh -o BatchMode=yes -T "$host" \
               "OLD='$old' FORCE='$FORCE_PUSH' DIRTY='$dirty'" 'bash -s' <<'REMOTE'
set -uo pipefail
dotfiles(){ /usr/bin/git --git-dir="$HOME/.dotfiles/" --work-tree="$HOME" "$@"; }
is_dirty(){ [ -n "${DIRTY:-}" ] && printf '%s\n' "$DIRTY" | grep -qxF -- "$1"; }

if [ -n "${OLD:-}" ] && [ "$OLD" != none ]; then
    mapfile -t CH < <(dotfiles diff --name-only "$OLD" main 2>/dev/null || true)
else
    mapfile -t CH < <(dotfiles ls-tree -r --name-only main 2>/dev/null || true)
fi
mapfile -t MISS < <(dotfiles diff --name-only --diff-filter=D main 2>/dev/null || true)

declare -A seen=(); TODO=()
for f in ${CH[@]+"${CH[@]}"} ${MISS[@]+"${MISS[@]}"}; do
    [ -n "$f" ] || continue
    [ -n "${seen[$f]:-}" ] && continue
    seen[$f]=1; TODO+=("$f")
done

upd=0; kept=0
for f in ${TODO[@]+"${TODO[@]}"}; do
    if [ "${FORCE:-false}" != true ] && is_dirty "$f"; then
        kept=$((kept+1)); continue
    fi
    dotfiles checkout main -- "$f" 2>/dev/null && upd=$((upd+1)) || true
done
echo "    updated $upd file(s); kept $kept local-modified file(s)"
REMOTE
        then
            ok+=("$host")
        else
            echo "    Remote apply failed." >&2
            failed+=("$host")
        fi
    done

    if [ "$PUSH_TO_GITHUB" = true ]; then
        echo "--> Syncing to: github"
        if ! dotfiles remote | grep -q '^github$'; then
            echo "    Warning: 'github' remote not found. Skipping." >&2
            echo "    Add it with: dotfiles remote add github https://github.com/mzember/dotfiles.git" >&2
        elif dotfiles push github main; then
            ok+=("github")
        else
            echo "    Push to github failed." >&2
            failed+=("github")
        fi
    fi

    echo "--- Sync summary ---"
    [ ${#ok[@]} -gt 0 ]      && echo "  synced:  ${ok[*]}"
    [ ${#skipped[@]} -gt 0 ] && echo "  skipped: ${skipped[*]} (offline)"
    [ ${#failed[@]} -gt 0 ]  && echo "  failed:  ${failed[*]}"
    [ ${#failed[@]} -gt 0 ] && return 1
    return 0
}

# --- fetch / diff (review changes coming FROM a host) ----------------------
cmd_fetch() {
    [ "$#" -eq 1 ] || { echo "Error: specify exactly one host to fetch from." >&2; usage; }
    local host="$1"
    echo "--- Fetching changes from $host ---"
    dotfiles fetch "$host"
    echo "Fetch complete. See changes with: dotfiles log main..$host/main"
}

cmd_diff() {
    [ "$#" -eq 1 ] || { echo "Error: specify exactly one host to diff against." >&2; usage; }
    local host="$1"
    echo "--- Diff between local 'main' and '$host/main' ---"
    echo "(Run 'dotfiles-sync fetch $host' first to update the remote-tracking branch.)"
    dotfiles diff "main..$host/main"
}

# --- host on/off/list ------------------------------------------------------
cmd_list() {
    ensure_hosts_file
    echo "Hosts file: $HOSTS_FILE"
    echo "  ENABLED:"
    enabled_hosts | sed 's/^/    /' || true
    echo "  DISABLED:"
    grep -E '^[[:space:]]*#[A-Za-z0-9._-]+[[:space:]]*$' "$HOSTS_FILE" 2>/dev/null \
        | sed -E 's/^[[:space:]]*#//; s/^/    /' || true
}

cmd_on() {
    [ "$#" -eq 1 ] || { echo "Usage: dotfiles-sync on <host>" >&2; exit 1; }
    ensure_hosts_file
    local host="$1" re; re=$(esc_re "$host")
    if grep -qE "^[[:space:]]*${re}[[:space:]]*$" "$HOSTS_FILE"; then
        echo "$host is already enabled."
    elif grep -qE "^[[:space:]]*#${re}[[:space:]]*$" "$HOSTS_FILE"; then
        sed -i -E "s/^[[:space:]]*#${re}[[:space:]]*\$/${host}/" "$HOSTS_FILE"
        echo "Enabled $host."
    else
        echo "$host" >> "$HOSTS_FILE"
        echo "Added and enabled $host."
    fi
}

cmd_off() {
    [ "$#" -eq 1 ] || { echo "Usage: dotfiles-sync off <host>" >&2; exit 1; }
    ensure_hosts_file
    local host="$1" re; re=$(esc_re "$host")
    if grep -qE "^[[:space:]]*${re}[[:space:]]*$" "$HOSTS_FILE"; then
        sed -i -E "s/^[[:space:]]*${re}[[:space:]]*\$/#${host}/" "$HOSTS_FILE"
        echo "Disabled $host (kept in file, commented out)."
    elif grep -qE "^[[:space:]]*#${re}[[:space:]]*$" "$HOSTS_FILE"; then
        echo "$host is already disabled."
    else
        echo "$host not found in $HOSTS_FILE." >&2
        exit 1
    fi
}

# --- dispatch --------------------------------------------------------------
[ $# -eq 0 ] && usage
COMMAND="$1"; shift
case "$COMMAND" in
    push)  cmd_push "$@" ;;
    fetch) cmd_fetch "$@" ;;
    diff)  cmd_diff "$@" ;;
    list)  cmd_list "$@" ;;
    on)    cmd_on "$@" ;;
    off)   cmd_off "$@" ;;
    *)     usage ;;
esac
